{
  "name": "lukeh.xyz",
  "version": "0.2.0",
  "description": "portfolio website",
  "homepage": "https://github.com/BlackHat-Magic/LukeH.xyz#readme",
  "bugs": {
    "url": "https://github.com/BlackHat-Magic/LukeH.xyz/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackHat-Magic/LukeH.xyz.git"
  },
  "license": "AGPL-3.0",
  "author": "BlackHat-Magic (Luke Henderson)",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build:ts": "bun run build.ts",
    "build:css": "bunx @tailwindcss/cli -i ./static/css/main.css -o ./public/dist/main.css --minify",
    "build:assets": "rm -rf public/images && cp -r static/images public/images && cp static/_redirects public/_redirects && cp static/_routes.json public/_routes.json",
    "build:all": "bun run build:ts && bun run build:css && bun run build:assets",
    "watch": "vite",
    "dev": "vite",
    "check": "./checks.sh",
    "deploy": "bun run build:all && wrangler pages deploy --branch master",
    "preview": "bun run build:all && wrangler pages dev",
    "clean": "rm -rf public/js/*.js public/dist/*.css",
    "test": "echo \"No tests yet\" && exit 1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/cli": "^4.1.18",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.0",
    "svelte": "^5",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.2.2",
    "wrangler": "^4.93.1"
  }
}
